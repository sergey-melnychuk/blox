# The relay's settings (DEPLOY.md). Install as /etc/blox/relay.env (root, mode 0644).
# `blox-relay --help` lists every option; limits are published at /v1/info (BLOX.md §8.4).

# Loopback only: Caddy is the only way in.
BLOX_LISTEN=localhost:8080
# Client addresses for the per-IP limits come from the X-Forwarded-For entry Caddy adds.
# Only ever set this behind a proxy you run.
BLOX_TRUST_PROXY=1
# error|warn|info|debug. info logs the start line; debug adds one line per request with the
# route template, status and latency (never paths, addresses or bodies).
BLOX_LOG=info

# Limits, if the defaults don't fit (BLOX.md §8.4):
#BLOX_MESSAGE_TTL_SECS=300
#BLOX_GLOBAL_MAX_BYTES=536870912
#BLOX_IP_WRITES_PER_MINUTE=60
#BLOX_IP_MAX_READERS=16

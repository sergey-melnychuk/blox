# TLS in front of the relay (BLOX.md §8.7). No `log` directive: Caddy writes no access log.
# Run the relay with --trust-proxy (BLOX_TRUST_PROXY=1) so rate limits see client addresses.
relay.example.com {
	reverse_proxy localhost:8080 {
		# Server-sent events: pass each event through at once.
		flush_interval -1
	}
}

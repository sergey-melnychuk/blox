{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@blox/sdk/wagmi": [
        "../src/wagmi.ts"
      ],
      "@blox/sdk": [
        "../src/index.ts"
      ],
      "@wagmi/core": [
        "./node_modules/@wagmi/core"
      ],
      "viem": [
        "./node_modules/viem"
      ],
      "viem/*": [
        "./node_modules/viem/*"
      ]
    }
  },
  "include": [
    "main.ts"
  ]
}
